.picker-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f5f6f8;
}

/* 顶部搜索栏（固定） */
.search-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  background: #fff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  flex-shrink: 0;
  z-index: 10;
}

.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  background: #f2f3f5;
  border-radius: 40rpx;
  padding: 0 24rpx;
  height: 72rpx;
}

.search-icon {
  font-size: 26rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
}

.search-clear {
  color: #bbb;
  font-size: 28rpx;
  padding: 8rpx;
}

.search-btn {
  background: #4A90E2;
  color: #fff;
  font-size: 28rpx;
  border-radius: 40rpx;
  padding: 0 32rpx;
  line-height: 72rpx;
  flex-shrink: 0;
}

/* 地图：占据主要区域，直接点选 */
.picker-map {
  flex: 1;
  width: 100%;
  height: 0;
}

/* 搜索结果浮层 */
.results-panel {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  top: 130rpx;
  max-height: 55vh;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
  overflow: hidden;
  z-index: 20;
  display: flex;
  flex-direction: column;
}

.results-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  font-weight: 700;
  border-bottom: 1rpx solid #f0f0f0;
  flex-shrink: 0;
}

.results-close {
  color: #999;
  font-size: 30rpx;
  padding: 4rpx 12rpx;
}

.results-list {
  flex: 1;
  height: 0;
  max-height: 48vh;
}

.poi-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.poi-icon {
  font-size: 36rpx;
  flex-shrink: 0;
}

.poi-info {
  flex: 1;
  overflow: hidden;
}

.poi-name {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 6rpx;
}

.poi-address {
  font-size: 24rpx;
  color: #999;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.poi-arrow {
  color: #ccc;
  font-size: 36rpx;
  flex-shrink: 0;
}

.empty {
  text-align: center;
  color: #999;
  padding: 60rpx 24rpx;
  font-size: 26rpx;
}

/* 底部确认栏 */
.bottom-bar {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 8rpx rgba(0, 0, 0, 0.05);
  flex-shrink: 0;
  z-index: 10;
}

.selected-addr {
  flex: 1;
  overflow: hidden;
}

.selected-label {
  display: block;
  font-size: 22rpx;
  color: #999;
}

.selected-text {
  display: block;
  font-size: 26rpx;
  color: #333;
  margin-top: 4rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.resolving {
  font-size: 22rpx;
  color: #FA8C16;
}

.confirm-btn {
  flex-shrink: 0;
  background: #4A90E2;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 44rpx;
  padding: 0 40rpx;
  line-height: 80rpx;
}
