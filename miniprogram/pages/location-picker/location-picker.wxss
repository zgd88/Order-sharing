.picker-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f5f6f8;
}

/* 顶部搜索栏（固定） */
.search-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  background: #fff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  flex-shrink: 0;
}

.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  background: #f2f3f5;
  border-radius: 40rpx;
  padding: 0 24rpx;
  height: 72rpx;
}

.search-icon {
  font-size: 26rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
}

.search-clear {
  color: #bbb;
  font-size: 28rpx;
  padding: 8rpx;
}

.search-btn {
  background: #4A90E2;
  color: #fff;
  font-size: 28rpx;
  border-radius: 40rpx;
  padding: 0 32rpx;
  line-height: 72rpx;
  flex-shrink: 0;
}

.nokey-tip {
  margin: 20rpx 24rpx 0;
  background: rgba(250, 140, 22, 0.1);
  color: #FA8C16;
  font-size: 24rpx;
  border-radius: 12rpx;
  padding: 20rpx;
  flex-shrink: 0;
}

/* 结果列表 */
.result-list {
  flex: 1;
  height: 0;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
}

.poi-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.poi-icon {
  font-size: 36rpx;
  flex-shrink: 0;
}

.poi-info {
  flex: 1;
  overflow: hidden;
}

.poi-name {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 6rpx;
}

.poi-address {
  font-size: 24rpx;
  color: #999;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.poi-arrow {
  color: #ccc;
  font-size: 36rpx;
  flex-shrink: 0;
}

.empty {
  text-align: center;
  color: #999;
  padding: 120rpx 0;
  font-size: 26rpx;
}

.empty.hint {
  color: #bbb;
}

.hint-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
}

/* 底部 */
.bottom-bar {
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 8rpx rgba(0, 0, 0, 0.05);
  flex-shrink: 0;
}

.map-btn {
  background: #fff;
  color: #4A90E2;
  border: 2rpx solid #4A90E2;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 84rpx;
  margin: 0;
}
