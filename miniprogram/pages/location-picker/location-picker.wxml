<view class="picker-page">
  <!-- 顶部搜索栏 -->
  <view class="search-bar">
    <view class="search-box">
      <text class="search-icon">🔍</text>
      <input
        class="search-input"
        placeholder="搜索地点，如：观山湖公园"
        value="{{keyword}}"
        bindinput="onKeyword"
        bindconfirm="search"
        confirm-type="search"
      />
      <text wx:if="{{keyword}}" class="search-clear" catchtap="onClear">✕</text>
    </view>
    <view class="search-btn" bindtap="search">{{searching ? '搜索中' : '搜索'}}</view>
  </view>

  <!-- 地图（直接内嵌展示，点击即可选点） -->
  <map
    id="pickerMap"
    class="picker-map"
    latitude="{{mapLat}}"
    longitude="{{mapLng}}"
    scale="15"
    show-location
    markers="{{markers}}"
    bindtap="onMapTap"
  ></map>

  <!-- 搜索结果浮层 -->
  <view wx:if="{{searched}}" class="results-panel">
    <view class="results-head">
      <text>搜索结果</text>
      <text class="results-close" bindtap="closeResults">✕</text>
    </view>
    <scroll-view scroll-y class="results-list">
      <view wx:if="{{noKey}}" class="empty">⚠️ 高德地图 Key 未配置，暂时无法搜索，可直接在地图上点选</view>
      <view wx:elif="{{!results.length}}" class="empty">未找到相关地点，换个关键词试试</view>
      <view
        class="poi-item"
        wx:for="{{results}}"
        wx:key="id"
        data-poi="{{item}}"
        bindtap="onSelectPoi"
      >
        <view class="poi-icon">📍</view>
        <view class="poi-info">
          <view class="poi-name">{{item.name}}</view>
          <view class="poi-address">{{item.fullAddress}}</view>
        </view>
        <view class="poi-arrow">›</view>
      </view>
    </scroll-view>
  </view>

  <!-- 底部确认栏 -->
  <view class="bottom-bar">
    <view class="selected-addr">
      <text class="selected-label">已选位置</text>
      <text class="selected-text">{{selection ? selection.address : '点击地图选择位置'}}</text>
      <text wx:if="{{resolving}}" class="resolving">解析中...</text>
    </view>
    <view class="confirm-btn" bindtap="confirmSelection">确认选择</view>
  </view>
</view>
