.user-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.avatar.big {
  width: 120rpx;
  height: 120rpx;
}

.user-info {
  flex: 1;
}

.user-name {
  font-size: 36rpx;
  font-weight: 700;
}

.edit-icon {
  font-size: 26rpx;
  color: #bbb;
}

.user-role {
  margin-top: 12rpx;
  display: flex;
  gap: 12rpx;
}

.cell-badge {
  font-size: 22rpx;
  color: #999;
  margin-left: 12rpx;
}

.cell-badge.pending { color: #FA8C16; }
.cell-badge.rejected { color: #F5222D; }
.cell-badge.approved { color: #52C41A; }

.cell-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.cell-sub {
  font-size: 24rpx;
  color: #999;
}

.logout-btn {
  margin: 40rpx 0;
  background: #fff;
  color: #F5222D;
  border-radius: 44rpx;
  font-size: 30rpx;
  line-height: 88rpx;
}
