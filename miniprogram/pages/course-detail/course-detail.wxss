.head {
  background: linear-gradient(135deg, #4A90E2, #6FA8E8);
  color: #fff;
  box-shadow: none;
}

.title {
  font-size: 38rpx;
  font-weight: 800;
  margin-bottom: 16rpx;
}

.tags {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
  flex-wrap: wrap;
}

.tags .tag {
  background: rgba(255, 255, 255, 0.2);
  color: #fff;
}

.price-line {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  flex-wrap: wrap;
}

.price.big {
  color: #fff;
  font-size: 60rpx;
}

.price.big .unit {
  font-size: 30rpx;
}

.per {
  font-size: 24rpx;
  opacity: 0.85;
}

.hint {
  margin-left: auto;
  background: rgba(255, 255, 255, 0.25);
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
}

.tier-row {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  border: 2rpx solid #eee;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  gap: 16rpx;
}

.tier-row.current {
  border-color: #4A90E2;
  background: rgba(74, 144, 226, 0.06);
}

.tier-count {
  flex: 1;
  font-size: 28rpx;
}

.tier-price {
  font-size: 30rpx;
  font-weight: 700;
  color: #F5222D;
}

.tier-tip {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.progress-bar {
  height: 20rpx;
  background: #f0f0f0;
  border-radius: 10rpx;
  overflow: hidden;
}

.progress-inner {
  height: 100%;
  background: linear-gradient(90deg, #4A90E2, #52C41A);
  border-radius: 10rpx;
  transition: width 0.4s;
}

.progress-meta {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  margin-top: 16rpx;
}

.progress-meta.sub {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

.orange { color: #FA8C16; }
.green { color: #52C41A; }

.teacher-row {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}

.teacher-info {
  flex: 1;
}

.teacher-name {
  font-size: 30rpx;
  font-weight: 600;
}

.teacher-meta {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.teacher-intro {
  font-size: 24rpx;
  color: #666;
  margin-top: 12rpx;
  background: #f8f9fb;
  padding: 16rpx;
  border-radius: 8rpx;
}

.info-row {
  display: flex;
  gap: 20rpx;
  font-size: 26rpx;
  padding: 12rpx 0;
}

.info-label {
  color: #999;
  flex-shrink: 0;
  width: 140rpx;
}

.outline {
  color: #666;
  white-space: pre-wrap;
  flex: 1;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  background: #fff;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
  gap: 24rpx;
}

.share-btn {
  text-align: center;
  flex-shrink: 0;
}

.share-icon {
  font-size: 44rpx;
}

.share-text {
  font-size: 20rpx;
  color: #666;
}

.join-btn {
  flex: 1;
  background: #F5222D;
  color: #fff;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 88rpx;
  margin: 0;
}

.join-btn[disabled] {
  background: #ccc !important;
  color: #fff !important;
}

.join-btn.joined {
  background: #52C41A;
}

page {
  padding-bottom: 160rpx;
}
