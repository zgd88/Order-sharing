.form-title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.form-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.form-item:last-of-type {
  border-bottom: none;
}

.form-label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.form-input {
  font-size: 30rpx;
  height: 56rpx;
  line-height: 56rpx;
}

.submit-btn {
  margin-top: 32rpx;
  width: 100%;
}
