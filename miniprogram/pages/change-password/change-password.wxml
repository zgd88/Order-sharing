<view class="container">
  <view class="card">
    <view class="form-title">修改密码</view>
    <view class="form-item">
      <view class="form-label">原密码</view>
      <input class="form-input" password placeholder="请输入原密码" value="{{oldPassword}}" data-key="oldPassword" bindinput="onField" />
    </view>
    <view class="form-item">
      <view class="form-label">新密码</view>
      <input class="form-input" password placeholder="至少 6 位" value="{{newPassword}}" data-key="newPassword" bindinput="onField" />
    </view>
    <view class="form-item">
      <view class="form-label">确认新密码</view>
      <input class="form-input" password placeholder="再次输入新密码" value="{{newPassword2}}" data-key="newPassword2" bindinput="onField" bindconfirm="submit" />
    </view>
    <button class="btn-primary submit-btn" bindtap="submit" disabled="{{submitting}}">确认修改</button>
  </view>
</view>
