.filter-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.filter-picker {
  background: #fff;
  border-radius: 12rpx;
  padding: 12rpx 24rpx;
  flex-shrink: 0;
}

.filter-item {
  font-size: 26rpx;
  color: #4A90E2;
  font-weight: 600;
}

.filter-note {
  font-size: 22rpx;
  color: #999;
}

.empty-sub {
  font-size: 24rpx;
  margin-top: 12rpx;
}

.demand-card { }

.d-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
  gap: 16rpx;
}

.d-title {
  font-size: 32rpx;
  font-weight: 700;
  flex: 1;
}

.d-rate {
  font-size: 36rpx;
}

.d-rate .unit {
  font-size: 22rpx;
}

.d-meta {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.d-foot {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: #999;
  padding-top: 14rpx;
  border-top: 1rpx solid #f5f5f5;
}

.d-count {
  color: #4A90E2;
}
