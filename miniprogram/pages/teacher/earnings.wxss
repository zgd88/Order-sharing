.hero {
  background: linear-gradient(135deg, #FA8C16, #F5222D);
  color: #fff;
  text-align: center;
  box-shadow: none;
}

.hero-label {
  font-size: 24rpx;
  opacity: 0.9;
}

.hero-num {
  font-size: 72rpx;
  font-weight: 800;
  margin: 12rpx 0;
}

.hero-sub {
  font-size: 24rpx;
  opacity: 0.85;
}

.form-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.empty.small {
  padding: 60rpx 0;
}

.earn-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
  gap: 20rpx;
}

.earn-row:last-child {
  border-bottom: none;
}

.earn-info {
  flex: 1;
}

.earn-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.earn-meta {
  font-size: 22rpx;
  color: #999;
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-wrap: wrap;
}

.earn-amount {
  text-align: right;
}

.earn-net {
  font-size: 34rpx;
}

.earn-gross {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.withdraw-note {
  font-size: 24rpx;
  color: #999;
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  line-height: 1.6;
}
