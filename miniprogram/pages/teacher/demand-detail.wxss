.head-card {
  background: linear-gradient(135deg, #4A90E2, #6FA8E8);
  color: #fff;
  box-shadow: none;
}

.head-title {
  font-size: 38rpx;
  font-weight: 800;
  margin-bottom: 16rpx;
}

.head-rate {
  font-size: 52rpx;
  font-weight: 800;
  margin-bottom: 16rpx;
}

.head-rate .unit {
  font-size: 26rpx;
  font-weight: 400;
}

.head-meta {
  font-size: 26rpx;
  opacity: 0.95;
}

.privacy-note {
  margin-top: 20rpx;
  font-size: 22rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 12rpx;
  padding: 14rpx 20rpx;
  line-height: 1.6;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.tip-text {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.form-label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.note-input {
  width: 100%;
  height: 180rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  background: #f8f9fb;
  border-radius: 12rpx;
  padding: 20rpx;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.apply-btn {
  background: #4A90E2;
  color: #fff;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 88rpx;
  margin: 0;
}

.apply-btn[disabled] {
  background: #b8d4f5 !important;
  color: #fff !important;
}

page {
  padding-bottom: 160rpx;
}
