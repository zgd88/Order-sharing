.form-title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.form-item {
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.form-item:last-child {
  border-bottom: none;
}

.form-item-row {
  display: flex;
  gap: 24rpx;
}

.form-item.half {
  flex: 1;
}

.form-label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.form-input {
  font-size: 30rpx;
  height: 56rpx;
  line-height: 56rpx;
}

.form-picker {
  font-size: 30rpx;
  color: #4A90E2;
}

.form-textarea {
  width: 100%;
  height: 160rpx;
  font-size: 28rpx;
}

.cover-box {
  height: 220rpx;
  border: 2rpx dashed #ccc;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.cover-img {
  width: 100%;
  height: 100%;
}

.cover-placeholder {
  color: #999;
}

.location-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.location-text {
  font-size: 28rpx;
  color: #4A90E2;
  flex: 1;
  margin-right: 16rpx;
  line-height: 1.5;
}

.location-text.placeholder {
  color: #999;
}

.tier-hint {
  font-size: 22rpx;
  color: #FA8C16;
  font-weight: 400;
  margin-left: 12rpx;
}

.tier-row-head {
  display: flex;
  font-size: 24rpx;
  color: #999;
  padding: 8rpx 0;
}

.tier-row-head text:first-child { width: 160rpx; }
.tier-row-head text:nth-child(2) { flex: 1; }
.tier-row-head text:last-child { width: 56rpx; }

.tier-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 0;
}

.tier-input {
  width: 140rpx;
  height: 72rpx;
  line-height: 72rpx;
  background: #f5f6f8;
  border-radius: 12rpx;
  text-align: center;
  font-size: 30rpx;
}

.tier-input[disabled] {
  color: #999;
  background: #f0f1f3;
}

.tier-input.price {
  flex: 1;
}

.tier-arrow {
  color: #ccc;
}

.tier-del {
  width: 56rpx;
  text-align: center;
  color: #F5222D;
  font-size: 32rpx;
}

.tier-del.placeholder {
  visibility: hidden;
}

.tier-add {
  color: #4A90E2;
  font-size: 26rpx;
  padding: 16rpx 0;
}

.config-row {
  margin-top: 16rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f5f5f5;
}

.tier-tip {
  font-size: 22rpx;
  color: #999;
  background: #f8f9fb;
  padding: 16rpx;
  border-radius: 8rpx;
  margin-top: 8rpx;
  line-height: 1.6;
}

.submit-btn {
  margin: 24rpx 0 48rpx;
  width: 100%;
}
