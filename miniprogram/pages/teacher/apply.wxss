.status-card {
  border-radius: 16rpx;
  padding: 28rpx;
  font-size: 28rpx;
  margin-bottom: 20rpx;
}

.status-card.pending {
  background: rgba(250, 140, 22, 0.1);
  color: #FA8C16;
}

.status-card.approved {
  background: rgba(82, 196, 26, 0.1);
  color: #52C41A;
}

.status-card.rejected {
  background: rgba(245, 34, 45, 0.08);
  color: #F5222D;
}

.form-title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.form-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.form-item:last-of-type {
  border-bottom: none;
}

.form-item-row {
  display: flex;
  gap: 24rpx;
}

.form-item.half {
  flex: 1;
}

.form-label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 14rpx;
}

.form-input {
  font-size: 30rpx;
  height: 56rpx;
  line-height: 56rpx;
}

.form-picker {
  font-size: 30rpx;
  color: #4A90E2;
}

.form-textarea {
  width: 100%;
  height: 140rpx;
  font-size: 28rpx;
}

.upload-row {
  display: flex;
  gap: 24rpx;
}

.upload-box {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed #ccc;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background: #fafafa;
}

.upload-img {
  width: 100%;
  height: 100%;
}

.upload-plus {
  text-align: center;
  color: #999;
  font-size: 48rpx;
  line-height: 1;
}

.upload-text {
  font-size: 22rpx;
  margin-top: 8rpx;
}

.submit-btn {
  margin-top: 32rpx;
  width: 100%;
}

.form-tip {
  margin-top: 16rpx;
  text-align: center;
  font-size: 22rpx;
  color: #bbb;
}

/* 多选展示行 */
.multi-select {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  font-size: 28rpx;
  min-height: 40rpx;
}

.multi-select .placeholder {
  color: #999;
}

/* 多选弹层 */
.picker-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 999;
  display: flex;
  align-items: flex-end;
}

.picker-panel {
  width: 100%;
  max-height: 75vh;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.picker-title {
  padding: 28rpx 32rpx 20rpx;
  font-size: 30rpx;
  font-weight: 700;
  border-bottom: 1rpx solid #f0f0f0;
  flex-shrink: 0;
}

.picker-sub {
  font-size: 22rpx;
  color: #999;
  font-weight: 400;
  margin-left: 16rpx;
}

.picker-list {
  flex: 1;
  height: 0; /* flex+height:0 让 scroll-view 在面板内滚动 */
  min-height: 240rpx;
  padding: 8rpx 32rpx;
  box-sizing: border-box;
}

.picker-option {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.checkbox {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 3rpx solid #ddd;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #fff;
  box-sizing: border-box;
}

.picker-option.checked .checkbox {
  background: #4A90E2;
  border-color: #4A90E2;
}

.picker-option.checked {
  color: #4A90E2;
  font-weight: 600;
}

.picker-footer {
  display: flex;
  gap: 24rpx;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #f0f0f0;
  flex-shrink: 0;
}

.picker-cancel,
.picker-confirm {
  flex: 1;
  border-radius: 44rpx;
  font-size: 30rpx;
  line-height: 84rpx;
  margin: 0;
}

.picker-cancel {
  background: #f5f6f8;
  color: #666;
}

.picker-confirm {
  background: #4A90E2;
  color: #fff;
  font-weight: 600;
}
