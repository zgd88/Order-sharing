.head-card {
  background: linear-gradient(135deg, #4A90E2, #6FA8E8);
  color: #fff;
  box-shadow: none;
}

.head-title {
  font-size: 34rpx;
  font-weight: 800;
  margin-bottom: 16rpx;
}

.head-meta {
  display: flex;
  gap: 12rpx;
  margin-bottom: 28rpx;
}

.head-meta .tag {
  background: rgba(255, 255, 255, 0.2);
  color: #fff;
}

.head-stats {
  display: flex;
  text-align: center;
  margin-bottom: 24rpx;
}

.head-stat {
  flex: 1;
}

.head-stat-num {
  font-size: 40rpx;
  font-weight: 800;
}

.head-stat-num.price {
  color: #fff;
}

.head-stat-label {
  font-size: 22rpx;
  opacity: 0.85;
  margin-top: 8rpx;
}

.head-tiers {
  font-size: 22rpx;
  background: rgba(255, 255, 255, 0.18);
  border-radius: 12rpx;
  padding: 12rpx 20rpx;
  margin-bottom: 24rpx;
}

.share-btn {
  background: #F5222D;
  color: #fff;
  border-radius: 44rpx;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 80rpx;
  margin-bottom: 16rpx;
}

.cancel-btn {
  background: transparent;
  color: rgba(255, 255, 255, 0.85);
  border: 2rpx solid rgba(255, 255, 255, 0.4);
  border-radius: 44rpx;
  font-size: 26rpx;
  line-height: 76rpx;
  margin: 0;
}

.form-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.empty.small {
  padding: 60rpx 0;
}

.member-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
  gap: 20rpx;
}

.member-row:last-child {
  border-bottom: none;
}

.member-info {
  flex: 1;
}

.member-name {
  font-size: 28rpx;
  font-weight: 600;
}

.member-meta {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.member-price {
  font-size: 32rpx;
}
