.form-title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.form-item {
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.form-item:last-child {
  border-bottom: none;
}

.form-item-row {
  display: flex;
  gap: 24rpx;
}

.form-item.half {
  flex: 1;
}

.form-label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.form-input {
  font-size: 30rpx;
  height: 56rpx;
  line-height: 56rpx;
}

.addr-input {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #666;
}

.form-picker {
  font-size: 30rpx;
  color: #4A90E2;
}

.location-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.location-text {
  font-size: 28rpx;
  color: #4A90E2;
  flex: 1;
  margin-right: 16rpx;
  line-height: 1.5;
}

.location-text.placeholder {
  color: #999;
}

.privacy-tip {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #999;
  background: #f8f9fb;
  border-radius: 8rpx;
  padding: 16rpx;
  line-height: 1.6;
}

.submit-btn {
  margin: 24rpx 0 48rpx;
  width: 100%;
}
