.login-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #4A90E2 0%, #6FA8E8 40%, #f5f6f8 40.1%);
  padding: 0 40rpx;
}

.logo-area {
  padding: 140rpx 0 60rpx;
  text-align: center;
  color: #fff;
}

.logo {
  width: 140rpx;
  height: 140rpx;
  line-height: 140rpx;
  border-radius: 32rpx;
  background: #fff;
  color: #4A90E2;
  font-size: 56rpx;
  font-weight: 800;
  margin: 0 auto 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
}

.slogan {
  font-size: 40rpx;
  font-weight: 700;
}

.sub-slogan {
  margin-top: 12rpx;
  font-size: 26rpx;
  opacity: 0.85;
}

.role-area {
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.role-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 28rpx;
}

.role-card {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border: 3rpx solid #eee;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  transition: all 0.2s;
}

.role-card.active {
  border-color: #4A90E2;
  background: rgba(74, 144, 226, 0.05);
}

.role-icon {
  font-size: 56rpx;
  margin-right: 24rpx;
}

.role-info { flex: 1; }

.role-name {
  font-size: 32rpx;
  font-weight: 600;
}

.role-desc {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #999;
}

.check {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 3rpx solid #ddd;
  box-sizing: border-box;
}

.check.checked {
  border-color: #4A90E2;
  background: #4A90E2;
  position: relative;
}

.check.checked::after {
  content: '';
  position: absolute;
  left: 10rpx;
  top: 5rpx;
  width: 10rpx;
  height: 18rpx;
  border-right: 4rpx solid #fff;
  border-bottom: 4rpx solid #fff;
  transform: rotate(45deg);
}

.login-btn {
  margin-top: 48rpx;
  width: 100%;
}

.tip {
  margin-top: 24rpx;
  text-align: center;
  color: #bbb;
  font-size: 24rpx;
}
