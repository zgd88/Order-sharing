<view class="login-page">
  <view class="logo-area">
    <view class="logo">培学</view>
    <view class="slogan">同城教培拼好课</view>
    <view class="sub-slogan">好老师拼着学，越拼越便宜</view>
  </view>

  <view class="auth-box">
    <!-- 登录/注册切换 -->
    <view class="mode-tabs">
      <view class="mode-tab {{mode === 'login' ? 'active' : ''}}" data-mode="login" bindtap="switchMode">登录</view>
      <view class="mode-tab {{mode === 'register' ? 'active' : ''}}" data-mode="register" bindtap="switchMode">注册</view>
    </view>

    <!-- 登录表单 -->
    <block wx:if="{{mode === 'login'}}">
      <view class="input-row">
        <text class="input-icon">📱</text>
        <input class="input" type="number" maxlength="11" placeholder="手机号" value="{{phone}}" data-key="phone" bindinput="onField" />
      </view>
      <view class="input-row">
        <text class="input-icon">🔒</text>
        <input class="input" password placeholder="密码" value="{{password}}" data-key="password" bindinput="onField" bindconfirm="doLogin" />
      </view>
      <button class="btn-primary main-btn" bindtap="doLogin" disabled="{{submitting}}">登 录</button>
      <view class="switch-tip">还没有账号？<text class="link" data-mode="register" bindtap="switchMode">立即注册</text></view>
    </block>

    <!-- 注册表单 -->
    <block wx:else>
      <view class="input-row">
        <text class="input-icon">📱</text>
        <input class="input" type="number" maxlength="11" placeholder="手机号" value="{{phone}}" data-key="phone" bindinput="onField" />
      </view>
      <view class="input-row">
        <text class="input-icon">🔒</text>
        <input class="input" password placeholder="设置密码（至少6位）" value="{{password}}" data-key="password" bindinput="onField" />
      </view>
      <view class="input-row">
        <text class="input-icon">🔒</text>
        <input class="input" password placeholder="确认密码" value="{{password2}}" data-key="password2" bindinput="onField" />
      </view>
      <view class="input-row">
        <text class="input-icon">👤</text>
        <input class="input" placeholder="昵称（选填）" value="{{nickname}}" data-key="nickname" bindinput="onField" />
      </view>
      <view class="role-row">
        <view class="role-card {{role === 'parent' ? 'active' : ''}}" data-role="parent" bindtap="selectRole">
          <view class="role-icon">👨‍👩‍👧</view>
          <view class="role-name">我是家长</view>
        </view>
        <view class="role-card {{role === 'teacher' ? 'active' : ''}}" data-role="teacher" bindtap="selectRole">
          <view class="role-icon">🧑‍🏫</view>
          <view class="role-name">我是老师</view>
        </view>
      </view>
      <button class="btn-primary main-btn" bindtap="doRegister" disabled="{{submitting}}">注册并登录</button>
      <view class="switch-tip">已有账号？<text class="link" data-mode="login" bindtap="switchMode">去登录</text></view>
    </block>
  </view>

  <!-- 演示模式 -->
  <view class="demo-area">
    <view class="demo-title">开发演示模式</view>
    <view class="role-row">
      <view class="role-card mini {{demoRole === 'parent' ? 'active' : ''}}" data-role="parent" bindtap="selectDemoRole">
        <view class="role-name">家长</view>
      </view>
      <view class="role-card mini {{demoRole === 'teacher' ? 'active' : ''}}" data-role="teacher" bindtap="selectDemoRole">
        <view class="role-name">老师</view>
      </view>
    </view>
    <button class="demo-btn" bindtap="doDemoLogin">演示模式进入</button>
  </view>
</view>
