page {
  background: #f5f6f8;
  font-size: 28rpx;
  color: #333;
  --primary: #4A90E2;
  --green: #52C41A;
  --orange: #FA8C16;
  --red: #F5222D;
}

.container {
  padding: 20rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.btn-primary {
  background: #4A90E2;
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 88rpx;
  text-align: center;
}

.btn-primary[disabled] {
  background: #b8d4f5 !important;
  color: #fff !important;
}

.btn-plain {
  border: 2rpx solid #4A90E2;
  color: #4A90E2;
  border-radius: 44rpx;
  font-size: 30rpx;
  line-height: 84rpx;
  text-align: center;
  background: #fff;
}

.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  line-height: 1.6;
}

.tag-blue { background: rgba(74, 144, 226, 0.12); color: #4A90E2; }
.tag-green { background: rgba(82, 196, 26, 0.12); color: #52C41A; }
.tag-orange { background: rgba(250, 140, 22, 0.12); color: #FA8C16; }
.tag-gray { background: rgba(0, 0, 0, 0.06); color: #999; }
.tag-red { background: rgba(245, 34, 45, 0.1); color: #F5222D; }

.price {
  color: #F5222D;
  font-weight: 700;
}

.price .unit {
  font-size: 22rpx;
}

.empty {
  text-align: center;
  color: #999;
  padding: 120rpx 0;
  font-size: 26rpx;
}

.cell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.cell:last-child { border-bottom: none; }

.arrow {
  width: 16rpx;
  height: 16rpx;
  border-top: 3rpx solid #ccc;
  border-right: 3rpx solid #ccc;
  transform: rotate(45deg);
}

.avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #e8e8e8;
  flex-shrink: 0;
}
